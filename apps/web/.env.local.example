# Rename this file to .env.local and fill in your values
# Get these from your Supabase project → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Sentry project DSN — leave blank to disable crash reporting
NEXT_PUBLIC_SENTRY_DSN=

# PostHog project API key + host — leave blank to disable analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Server only (never prefix with NEXT_PUBLIC_). Used by /api/admin/* to manage
# partners, rewards, code pools, reports and campaigns after checking the
# caller is an admin. Supabase project → Settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# Waitlist welcome email (Resend). Both are server only. Leave blank to skip the email:
# sign-ups are still saved. The sending domain must be verified in Resend.
RESEND_API_KEY=
WAITLIST_FROM=Mehtab from Runivo <mehtab@runivo.in>
# Optional: where replies go (defaults to the support address in lib/site.ts)
WAITLIST_REPLY_TO=
# Studio → Website (server only): PostHog personal API key with only "Query: read", and the project number
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=

# Email broadcasts from Studio (server only). A FULL-ACCESS Resend key (segments, contacts, broadcasts);
# the sending-only key above cannot do this. BROADCAST_FROM falls back to WAITLIST_FROM.
RESEND_ADMIN_KEY=
BROADCAST_FROM=

# Studio AI helpers (server only): Anthropic key. ANTHROPIC_FAST_MODEL is optional (default: Claude Haiku).
ANTHROPIC_API_KEY=
ANTHROPIC_FAST_MODEL=

# Studio daily digest email (server only). Vercel Cron calls /api/cron/admin-digest with
# "Authorization: Bearer <CRON_SECRET>"; set the same value in Vercel. DIGEST_FROM is optional.
CRON_SECRET=
DIGEST_FROM=

# Studio Overview: the waitlist sign-ups wanted per launch city (default 200).
LAUNCH_CITY_TARGET=

# Build-time only (uploads source maps to Sentry). Leave blank to skip.
SENTRY_ORG=
SENTRY_PROJECT=
